{
  "srl_nokia-interfaces:interface": [
    {
      "name": "ethernet-1/1",
      "admin-state": "enable",
      "subinterface": [
        {
          "index": 0,
          "type": "srl_nokia-interfaces:routed",
          "admin-state": "enable",
          "ipv4": {
            "admin-state": "enable",
            "address": [
              {
                "ip-prefix": "192.168.11.1/30"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "ethernet-1/2",
      "admin-state": "enable",
      "subinterface": [
        {
          "index": 0,
          "type": "srl_nokia-interfaces:routed",
          "admin-state": "enable",
          "ipv4": {
            "admin-state": "enable",
            "address": [
              {
                "ip-prefix": "192.168.12.1/30"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "mgmt0",
      "admin-state": "enable",
      "subinterface": [
        {
          "index": 0,
          "admin-state": "enable",
          "ipv4": {
            "admin-state": "enable",
            "srl_nokia-interfaces-ip-dhcp:dhcp-client": {
              
            }
          },
          "ipv6": {
            "admin-state": "enable",
            "srl_nokia-interfaces-ip-dhcp:dhcp-client": {
              
            }
          }
        }
      ]
    },
    {
      "name": "system0",
      "subinterface": [
        {
          "index": 0,
          "ipv4": {
            "admin-state": "enable",
            "address": [
              {
                "ip-prefix": "10.0.0.1/32"
              }
            ]
          }
        }
      ]
    }
  ],
  "srl_nokia-network-instance:network-instance": [
    {
      "name": "default",
      "interface": [
        {
          "name": "ethernet-1/1.0"
        },
        {
          "name": "ethernet-1/2.0"
        },
        {
          "name": "system0.0"
        }
      ],
      "protocols": {
        "srl_nokia-isis:isis": {
          "instance": [
            {
              "name": "ISIS",
              "admin-state": "enable",
              "level-capability": "L2",
              "max-ecmp-paths": 2,
              "net": [
                "49.0001.0000.0000.0001.00"
              ],
              "ipv4-unicast": {
                "admin-state": "enable"
              },
              "interface": [
                {
                  "interface-name": "ethernet-1/1.0",
                  "circuit-type": "point-to-point",
                  "ipv4-unicast": {
                    "admin-state": "enable"
                  }
                },
                {
                  "interface-name": "ethernet-1/2.0",
                  "circuit-type": "point-to-point",
                  "ipv4-unicast": {
                    "admin-state": "enable"
                  }
                },
                {
                  "interface-name": "system0.0",
                  "ipv4-unicast": {
                    "admin-state": "enable"
                  }
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "mgmt",
      "type": "srl_nokia-network-instance:ip-vrf",
      "admin-state": "enable",
      "description": "Management network instance",
      "interface": [
        {
          "name": "mgmt0.0"
        }
      ],
      "protocols": {
        "srl_nokia-linux:linux": {
          "import-routes": true,
          "export-routes": true,
          "export-neighbors": true
        }
      }
    }
  ]
}
