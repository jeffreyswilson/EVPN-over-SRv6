{
  "srl_nokia-interfaces:interface": [
    {
      "name": "ethernet-1/1",
      "admin-state": "enable",
      "subinterface": [
        {
          "index": 0,
          "type": "srl_nokia-interfaces:routed",
          "admin-state": "enable",
          "ipv4": {
            "admin-state": "enable",
            "address": [
              {
                "ip-prefix": "192.168.11.2/30"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "ethernet-1/2",
      "admin-state": "enable",
      "subinterface": [
        {
          "index": 0,
          "type": "srl_nokia-interfaces:routed",
          "admin-state": "enable",
          "ipv4": {
            "admin-state": "enable",
            "address": [
              {
                "ip-prefix": "192.168.21.2/30"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "ethernet-1/3",
      "srl_nokia-interfaces-vlans:vlan-tagging": true,
      "subinterface": [
        {
          "index": 0,
          "type": "srl_nokia-interfaces:bridged",
          "admin-state": "enable",
          "srl_nokia-interfaces-vlans:vlan": {
            "encap": {
              "single-tagged": {
                "vlan-id": 10
              }
            }
          }
        },
        {
          "index": 1,
          "type": "srl_nokia-interfaces:bridged",
          "admin-state": "enable",
          "srl_nokia-interfaces-vlans:vlan": {
            "encap": {
              "single-tagged": {
                "vlan-id": 20
              }
            }
          }
        }
      ]
    },
    {
      "name": "irb0",
      "subinterface": [
        {
          "index": 1,
          "admin-state": "enable",
          "ipv4": {
            "admin-state": "enable",
            "address": [
              {
                "ip-prefix": "192.168.0.254/24",
                "anycast-gw": true
              }
            ],
            "srl_nokia-interfaces-nbr:arp": {
              "srl_nokia-interfaces-nbr-evpn:evpn": {
                "advertise": [
                  {
                    "route-type": "dynamic"
                  }
                ]
              }
            }
          },
          "anycast-gw": {
            "virtual-router-id": 10
          }
        },
        {
          "index": 2,
          "admin-state": "enable",
          "ipv4": {
            "admin-state": "enable",
            "address": [
              {
                "ip-prefix": "192.168.1.254/24",
                "anycast-gw": true
              }
            ],
            "srl_nokia-interfaces-nbr:arp": {
              "srl_nokia-interfaces-nbr-evpn:evpn": {
                "advertise": [
                  {
                    "route-type": "dynamic"
                  }
                ]
              }
            }
          },
          "anycast-gw": {
            "virtual-router-id": 20
          }
        }
      ]
    },
    {
      "name": "mgmt0",
      "admin-state": "enable",
      "subinterface": [
        {
          "index": 0,
          "admin-state": "enable",
          "ipv4": {
            "admin-state": "enable",
            "srl_nokia-interfaces-ip-dhcp:dhcp-client": {
              
            }
          },
          "ipv6": {
            "admin-state": "enable",
            "srl_nokia-interfaces-ip-dhcp:dhcp-client": {
              
            }
          }
        }
      ]
    },
    {
      "name": "system0",
      "subinterface": [
        {
          "index": 0,
          "ipv4": {
            "admin-state": "enable",
            "address": [
              {
                "ip-prefix": "10.0.0.3/32"
              }
            ]
          }
        }
      ]
    }
  ],
  "srl_nokia-network-instance:network-instance": [
    {
      "name": "default",
      "interface": [
        {
          "name": "ethernet-1/1.0"
        },
        {
          "name": "ethernet-1/2.0"
        },
        {
          "name": "system0.0"
        }
      ],
      "protocols": {
        "srl_nokia-isis:isis": {
          "instance": [
            {
              "name": "ISIS",
              "admin-state": "enable",
              "level-capability": "L2",
              "max-ecmp-paths": 2,
              "net": [
                "49.0001.0000.0000.0003.00"
              ],
              "ipv4-unicast": {
                "admin-state": "enable"
              },
              "interface": [
                {
                  "interface-name": "ethernet-1/1.0",
                  "circuit-type": "point-to-point",
                  "ipv4-unicast": {
                    "admin-state": "enable"
                  }
                },
                {
                  "interface-name": "ethernet-1/2.0",
                  "circuit-type": "point-to-point",
                  "ipv4-unicast": {
                    "admin-state": "enable"
                  }
                },
                {
                  "interface-name": "system0.0",
                  "ipv4-unicast": {
                    "admin-state": "enable"
                  }
                }
              ]
            }
          ]
        },
        "srl_nokia-bgp:bgp": {
          "autonomous-system": 64512,
          "router-id": "10.0.0.3",
          "afi-safi": [
            {
              "afi-safi-name": "srl_nokia-common:evpn",
              "admin-state": "enable"
            }
          ],
          "group": [
            {
              "group-name": "iBGP-overlay",
              "peer-as": 64512,
              "export-policy": [
                "all"
              ],
              "import-policy": [
                "all"
              ],
              "afi-safi": [
                {
                  "afi-safi-name": "srl_nokia-common:evpn",
                  "admin-state": "enable"
                },
                {
                  "afi-safi-name": "srl_nokia-common:ipv4-unicast",
                  "admin-state": "disable"
                }
              ],
              "local-as": {
                "as-number": 64512
              },
              "timers": {
                "minimum-advertisement-interval": 1
              }
            }
          ],
          "neighbor": [
            {
              "peer-address": "10.0.0.4",
              "peer-group": "iBGP-overlay",
              "transport": {
                "local-address": "10.0.0.3"
              }
            }
          ]
        }
      }
    },
    {
      "name": "mgmt",
      "type": "srl_nokia-network-instance:ip-vrf",
      "admin-state": "enable",
      "description": "Management network instance",
      "interface": [
        {
          "name": "mgmt0.0"
        }
      ],
      "protocols": {
        "srl_nokia-linux:linux": {
          "import-routes": true,
          "export-routes": true,
          "export-neighbors": true
        }
      }
    },
    {
      "name": "vrf-1",
      "type": "srl_nokia-network-instance:mac-vrf",
      "admin-state": "enable",
      "interface": [
        {
          "name": "ethernet-1/3.0"
        },
        {
          "name": "irb0.1"
        }
      ],
      "vxlan-interface": [
        {
          "name": "vxlan1.1"
        }
      ],
      "protocols": {
        "bgp-evpn": {
          "srl_nokia-bgp-evpn:bgp-instance": [
            {
              "id": 1,
              "admin-state": "enable",
              "vxlan-interface": "vxlan1.1",
              "evi": 3876
            }
          ]
        },
        "srl_nokia-bgp-vpn:bgp-vpn": {
          "bgp-instance": [
            {
              "id": 1,
              "route-target": {
                "export-rt": "target:64512:3876",
                "import-rt": "target:64512:3876"
              }
            }
          ]
        }
      }
    },
    {
      "name": "vrf-2",
      "type": "srl_nokia-network-instance:mac-vrf",
      "admin-state": "enable",
      "interface": [
        {
          "name": "ethernet-1/3.1"
        },
        {
          "name": "irb0.2"
        }
      ],
      "vxlan-interface": [
        {
          "name": "vxlan1.2"
        }
      ],
      "protocols": {
        "bgp-evpn": {
          "srl_nokia-bgp-evpn:bgp-instance": [
            {
              "id": 1,
              "admin-state": "enable",
              "vxlan-interface": "vxlan1.2",
              "evi": 3877
            }
          ]
        },
        "srl_nokia-bgp-vpn:bgp-vpn": {
          "bgp-instance": [
            {
              "id": 1,
              "route-target": {
                "export-rt": "target:64512:3877",
                "import-rt": "target:64512:3877"
              }
            }
          ]
        }
      }
    },
    {
      "name": "vrf-l3",
      "type": "srl_nokia-network-instance:ip-vrf",
      "admin-state": "enable",
      "interface": [
        {
          "name": "irb0.1"
        },
        {
          "name": "irb0.2"
        }
      ],
      "vxlan-interface": [
        {
          "name": "vxlan1.3"
        }
      ],
      "protocols": {
        "bgp-evpn": {
          "srl_nokia-bgp-evpn:bgp-instance": [
            {
              "id": 1,
              "admin-state": "enable",
              "vxlan-interface": "vxlan1.3",
              "evi": 3878
            }
          ]
        },
        "srl_nokia-bgp-vpn:bgp-vpn": {
          "bgp-instance": [
            {
              "id": 1,
              "route-target": {
                "export-rt": "target:64512:3878",
                "import-rt": "target:64512:3878"
              }
            }
          ]
        }
      }
    }
  ],
  "srl_nokia-tunnel-interfaces:tunnel-interface": [
    {
      "name": "vxlan1",
      "vxlan-interface": [
        {
          "index": 1,
          "type": "srl_nokia-interfaces:bridged",
          "ingress": {
            "vni": 89526
          }
        },
        {
          "index": 2,
          "type": "srl_nokia-interfaces:bridged",
          "ingress": {
            "vni": 89527
          }
        },
        {
          "index": 3,
          "type": "srl_nokia-interfaces:routed",
          "ingress": {
            "vni": 89528
          }
        }
      ]
    }
  ],
  "srl_nokia-routing-policy:routing-policy": {
    "policy": [
      {
        "name": "all",
        "default-action": {
          "policy-result": "accept"
        }
      }
    ]
  }
}
